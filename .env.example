# ============================================================
# Application
# ============================================================

NODE_ENV=production

# Optional.
# If empty, the monitor uses the operating system hostname.
HOST_NAME=

# How often the monitor runs all checks.
# 30000 = 30 seconds
MONITOR_INTERVAL_MS=30000


# ============================================================
# Resource Thresholds
# ============================================================

# CPU usage warning threshold (%)
CPU_WARNING_THRESHOLD=85

# RAM usage warning threshold (%)
RAM_WARNING_THRESHOLD=85

# Swap usage warning threshold (%)
SWAP_WARNING_THRESHOLD=50

# Disk usage warning threshold (%)
DISK_WARNING_THRESHOLD=90

# Load average warning multiplier.
# Example:
# 4 CPU cores × 1.5 = load warning around 6.0
LOAD_WARNING_MULTIPLIER=1.5

# CPU temperature warning threshold (°C)
CPU_TEMP_WARNING_THRESHOLD=80


# ============================================================
# Alert Behavior
# ============================================================

# Number of consecutive failed checks before sending an alert.
ALERT_AFTER_CONSECUTIVE_FAILURES=3

# Resource usage must fall below this percentage to trigger
# a recovery notification.
RECOVERY_THRESHOLD=75

# Minimum time between repeated alerts for the same metric.
# 900000 = 15 minutes
ALERT_COOLDOWN_MS=900000


# ============================================================
# Filesystem Monitoring
# ============================================================

# Comma-separated list of filesystem mount points to monitor.
#
# Examples:
#   /
#   /,/home
#   /,/var
#
MONITORED_FILESYSTEMS=/


# ============================================================
# Telegram
# ============================================================

# Telegram Bot API token.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID that is allowed to receive alerts
# and execute monitor commands.
TELEGRAM_CHAT_ID=


# ============================================================
# Service Monitoring
# ============================================================

# Enable/disable service monitoring.
CHECK_SERVICES=true

# Comma-separated list of services to monitor.
#
# Supported built-in services include:
#   nginx
#   apache
#   apache2
#   mysql
#   mariadb
#   postgresql
#   postgres
#   mongodb
#   mongo
#   mssql
#   sqlserver
#   redis
#
# Custom services can also be configured below.
#
SERVICES=nginx,mysql,redis


# ------------------------------------------------------------
# Nginx
# ------------------------------------------------------------

# Check type:
#   systemd
SERVICE_NGINX_TYPE=systemd

# systemd service name.
SERVICE_NGINX_SYSTEMD_NAME=nginx


# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------

# Check type:
#   tcp
SERVICE_MYSQL_TYPE=tcp

# Hostname/IP of the MySQL server.
#
# Host machine:
#   127.0.0.1
#
# Docker:
#   mysql
#
# Kubernetes:
#   mysql.database.svc.cluster.local
#
SERVICE_MYSQL_HOST=127.0.0.1

SERVICE_MYSQL_PORT=3306


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

SERVICE_REDIS_TYPE=tcp

# Host machine:
#   127.0.0.1
#
# Docker:
#   redis
#
# Kubernetes:
#   redis.cache.svc.cluster.local
#
SERVICE_REDIS_HOST=127.0.0.1

SERVICE_REDIS_PORT=6379


# ============================================================
# Optional Service Examples
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# SERVICE_POSTGRESQL_TYPE=tcp
# SERVICE_POSTGRESQL_HOST=127.0.0.1
# SERVICE_POSTGRESQL_PORT=5432


# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------

# SERVICE_MONGODB_TYPE=tcp
# SERVICE_MONGODB_HOST=127.0.0.1
# SERVICE_MONGODB_PORT=27017


# ------------------------------------------------------------
# Microsoft SQL Server
# ------------------------------------------------------------

# SERVICE_MSSQL_TYPE=tcp
# SERVICE_MSSQL_HOST=127.0.0.1
# SERVICE_MSSQL_PORT=1433


# ------------------------------------------------------------
# Apache
# ------------------------------------------------------------

# SERVICE_APACHE_TYPE=systemd
# SERVICE_APACHE_SYSTEMD_NAME=apache2


# ============================================================
# Custom HTTP Service
# ============================================================

# Add the service name to SERVICES first:
#
# SERVICES=nginx,mysql,redis,ragashop-api
#
# Then configure it:

# SERVICE_RAGASHOP_API_TYPE=http
# SERVICE_RAGASHOP_API_URL=http://127.0.0.1:9005


# ============================================================
# HTTP Endpoint Monitoring
# ============================================================

# Enable/disable HTTP endpoint monitoring.
CHECK_ENDPOINTS=true

# Comma-separated list:
#
# NAME|URL,NAME|URL
#
# Example:
#
# ENDPOINTS=RagaShop API|http://127.0.0.1:9005,RagaShop Web|http://127.0.0.1:3000
#
ENDPOINTS=RagaShop API|http://127.0.0.1:9005,RagaShop Web|http://127.0.0.1:3000


# ============================================================
# Logging
# ============================================================

# Pino log level.
#
# Available levels:
#   trace
#   debug
#   info
#   warn
#   error
#   fatal
#
LOG_LEVEL=info