# =========================================================
# SERVER
# =========================================================

NODE_ENV=production

# Leave empty to use the machine hostname
HOST_NAME=

# Metrics collection interval
# 30000 = 30 seconds
MONITOR_INTERVAL_MS=30000


# =========================================================
# RESOURCE THRESHOLDS
# =========================================================

CPU_WARNING_THRESHOLD=85

RAM_WARNING_THRESHOLD=85

SWAP_WARNING_THRESHOLD=50

DISK_WARNING_THRESHOLD=90

# Load warning = CPU cores × this value
LOAD_WARNING_MULTIPLIER=1.5

# Only checked if the OS exposes CPU temperature
CPU_TEMP_WARNING_THRESHOLD=80


# =========================================================
# ALERT BEHAVIOR
# =========================================================

# Number of consecutive failed checks before sending alert
ALERT_AFTER_CONSECUTIVE_FAILURES=3

# Resource must fall below this value to be considered recovered
RECOVERY_THRESHOLD=75

# Prevent repeated alerts
# 900000 = 15 minutes
ALERT_COOLDOWN_MS=900000


# =========================================================
# DISK
# =========================================================

# Comma-separated mount points
MONITORED_FILESYSTEMS=/


# =========================================================
# TELEGRAM
# =========================================================

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=


# =========================================================
# SERVICE CHECKS
# =========================================================

CHECK_SERVICES=true

# Linux systemd service names
SERVICES=nginx,mysql,redis


# =========================================================
# HTTP ENDPOINT CHECKS
# =========================================================

CHECK_ENDPOINTS=true

# Format:
# Name|URL,Name|URL
#
# IMPORTANT:
# No spaces around "|" are required.
#
ENDPOINTS=sample API|http://127.0.0.1:9005,RagaShop Web|http://127.0.0.1:3000


# =========================================================
# LOGGING
# =========================================================

LOG_LEVEL=info

